{
  "name": "parallax",
  "displayName": "Parallax",
  "description": "Local-first development history for VS Code",
  "version": "0.1.0",
  "publisher": "parallax-dev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "parallax",
          "title": "Parallax",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "parallax": [
        {
          "id": "parallax.timeline",
          "name": "History"
        }
      ]
    },
    "commands": [
      {
        "command": "parallax.startRecording",
        "title": "Parallax: Start Recording"
      },
      {
        "command": "parallax.stopRecording",
        "title": "Parallax: Stop Recording"
      },
      {
        "command": "parallax.openTimeline",
        "title": "Parallax: Open Timeline"
      },
      {
        "command": "parallax.createCheckpoint",
        "title": "Parallax: Create Checkpoint"
      }
    ],
    "configuration": {
      "title": "Parallax",
      "properties": {
        "parallax.recordingEnabled": {
          "type": "boolean",
          "default": true
        },
        "parallax.snapshotIntervalMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1
        },
        "parallax.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/build/**",
            "**/.parallax/**",
            "**/.env",
            "**/.env.*",
            "**/*.pem",
            "**/*.key",
            "**/id_rsa",
            "**/id_ed25519",
            "**/secrets/**"
          ]
        },
        "parallax.maxEventsPerSession": {
          "type": "number",
          "default": 10000,
          "minimum": 100
        },
        "parallax.debounceMs": {
          "type": "number",
          "default": 1000,
          "minimum": 0
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:extension && npm run build:webview",
    "build:extension": "tsc -p .",
    "build:webview": "webpack --mode production",
    "watch": "tsc -watch -p .",
    "watch:webview": "webpack --mode development --watch",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test": "npm run compile-tests && mocha \"out/test/**/*.test.js\" --timeout 10000",
    "test:integration": "npm run build && npm run compile-tests && node out/test/integration/run.js",
    "package": "npx --yes @vscode/vsce@2.27.0 package --allow-missing-repository",
    "test:package-host": "npm run compile-tests && node out/test/integration/run-installed.js"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.5.2",
    "jsdom": "^26.1.0",
    "mocha": "^12.0.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.7.2",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Parag-098/Parallax.git"
  }
}
